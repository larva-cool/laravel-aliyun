{
  "name": "larva/laravel-aliyun",
  "description": "This is a Laravel expansion for the Aliyun.",
  "keywords": [
    "Larva",
    "laravel",
    "aliyun"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-simplexml": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "alibabacloud/sdk": "^1.8",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/bus": "^12.0|^13.0",
    "illuminate/queue": "^12.0|^13.0"
  },
  "require-dev": {
    "laravel/framework": "^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Larva\\Aliyun\\": "src"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "2.0-dev"
    },
    "laravel": {
      "providers": [
        "Larva\\Aliyun\\AliyunServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
